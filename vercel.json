{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "trailingSlash": false,
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 10,
      "includeFiles": "{src/data/**,universities.json}"
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.gapwise.ca"
        }
      ],
      "destination": "https://gapwise.ca/:path*",
      "permanent": true
    },
    {
      "source": "/utm-timetable",
      "has": [
        {
          "type": "host",
          "value": "gapwise.ca"
        }
      ],
      "destination": "https://utm.gapwise.ca/utm-timetable",
      "permanent": true
    },
    {
      "source": "/acorn-import",
      "has": [
        {
          "type": "host",
          "value": "gapwise.ca"
        }
      ],
      "destination": "https://utm.gapwise.ca/acorn-import",
      "permanent": true
    },
    {
      "source": "/places/:path*",
      "has": [
        {
          "type": "host",
          "value": "gapwise.ca"
        }
      ],
      "destination": "https://utm.gapwise.ca/places/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "gapwise-utm.vercel.app"
        }
      ],
      "destination": "https://gapwise.ca/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "api.gapwise.ca"
        }
      ],
      "destination": "https://api.gapwise.ca/v1",
      "permanent": false
    },
    {
      "source": "/openai-review/demo.mp4",
      "destination": "/openai-review",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://tiles.openfreemap.org; connect-src 'self' blob: https://tiles.openfreemap.org https://accounts.google.com https://olrtvbblxbgcxbhvujaw.supabase.co wss://olrtvbblxbgcxbhvujaw.supabase.co https://ai.gapwise.ca; worker-src 'self'; frame-src https://accounts.google.com; frame-ancestors 'none'; object-src 'none'; media-src 'self' blob:; manifest-src 'self'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/mail",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    },
    {
      "source": "/openai-review/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sdk/gapwise-utm.d.ts",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(favicon.svg|favicon-16x16.png|favicon-32x32.png|favicon-192x192.png|og-gapwise.png|og-card.png|apple-touch-icon.png|icon-192.png|icon-512.png|site.webmanifest|robots.txt|sitemap.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/today",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/timetable",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/gaps",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/route",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/route/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/oauth/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/v1",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/v1/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/_seo/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/openai-review",
      "destination": "/openai-review/index.html"
    },
    {
      "source": "/api/version",
      "destination": "/api/health?view=version"
    },
    {
      "source": "/api/telemetry",
      "destination": "/api/health?view=telemetry"
    },
    {
      "source": "/v1",
      "destination": "/api/v1?resource=root"
    },
    {
      "source": "/v1/universities",
      "destination": "/api/v1?resource=universities"
    },
    {
      "source": "/v1/universities/:id",
      "destination": "/api/v1?resource=university&id=:id"
    },
    {
      "source": "/v1/campuses",
      "destination": "/api/v1?resource=campuses"
    },
    {
      "source": "/v1/campuses/:id",
      "destination": "/api/v1?resource=campus&id=:id"
    },
    {
      "source": "/v1/buildings",
      "destination": "/api/v1?resource=buildings"
    },
    {
      "source": "/v1/buildings/:building",
      "destination": "/api/v1?resource=building&building=:building"
    },
    {
      "source": "/v1/places",
      "destination": "/api/v1?resource=places"
    },
    {
      "source": "/v1/places/:placeId",
      "destination": "/api/v1?resource=place&placeId=:placeId"
    },
    {
      "source": "/v1/routes",
      "destination": "/api/v1?resource=routes"
    },
    {
      "source": "/v1/gaps/plan",
      "destination": "/api/v1?resource=gap-plan"
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "(?<site>(?!api\\b)[a-z0-9-]+)\\.gapwise\\.ca"
        }
      ],
      "destination": "/_sites/:site/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "(?<site>(?!api\\b)[a-z0-9-]+)\\.gapwise\\.ca"
        }
      ],
      "destination": "/_sites/:site/robots.txt"
    },
    {
      "source": "/:path(about|universities|open-source|campus-map|gap-planner|campus-routing|developers|ai|support|trust|privacy|security|accessibility)",
      "has": [
        {
          "type": "host",
          "value": "(?<site>(?!api\\b)[a-z0-9-]+)\\.gapwise\\.ca"
        }
      ],
      "destination": "/_sites/:site/_seo/:path.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?<site>(?!api\\b)[a-z0-9-]+)\\.gapwise\\.ca"
        }
      ],
      "destination": "/_sites/:site/index.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<site>(?!api\\b)[a-z0-9-]+)\\.gapwise\\.ca"
        }
      ],
      "destination": "/_sites/:site/index.html"
    },
    {
      "source": "/(og-card.png|og-gapwise.png)",
      "destination": "/_global/og-gapwise.png"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/_seo/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/_seo/robots.txt"
    },
    {
      "source": "/about",
      "destination": "/_seo/about.html"
    },
    {
      "source": "/universities",
      "destination": "/_seo/universities.html"
    },
    {
      "source": "/open-source",
      "destination": "/_seo/open-source.html"
    },
    {
      "source": "/campus-map",
      "destination": "/_seo/campus-map.html"
    },
    {
      "source": "/gap-planner",
      "destination": "/_seo/gap-planner.html"
    },
    {
      "source": "/campus-routing",
      "destination": "/_seo/campus-routing.html"
    },
    {
      "source": "/developers",
      "destination": "/_seo/developers.html"
    },
    {
      "source": "/ai",
      "destination": "/_seo/ai.html"
    },
    {
      "source": "/support",
      "destination": "/_seo/support.html"
    },
    {
      "source": "/trust",
      "destination": "/_seo/trust.html"
    },
    {
      "source": "/privacy",
      "destination": "/_seo/privacy.html"
    },
    {
      "source": "/security",
      "destination": "/_seo/security.html"
    },
    {
      "source": "/accessibility",
      "destination": "/_seo/accessibility.html"
    },
    {
      "source": "/terms",
      "destination": "/_seo/terms.html"
    },
    {
      "source": "/",
      "destination": "/_seo/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/_seo/index.html"
    }
  ]
}
